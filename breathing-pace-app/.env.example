# Breathing Pace Learning Assistant - Environment Configuration Example
# .env.example 파일을 .env로 복사하여 사용하세요

# 데이터베이스 설정
DB_HOST=localhost
DB_NAME=breathing_pace_db
DB_USER=breathing_user
DB_PASS=your_secure_password_here
DB_CHARSET=utf8mb4

# Moodle 설정 (선택사항 - UI에서도 설정 가능)
MOODLE_URL=https://your-moodle.com
MOODLE_TOKEN=your_moodle_api_token_here

# 애플리케이션 설정
DEBUG_MODE=true
SESSION_TIMEOUT=1800
DEFAULT_CYCLES=3

# 보안 설정
ALLOWED_ORIGINS=*
# 프로덕션: ALLOWED_ORIGINS=https://your-domain.com

# 로그 설정
LOG_LEVEL=debug
# 옵션: debug, info, warning, error

# 타임존
TIMEZONE=Asia/Seoul
