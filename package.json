{
  "name": "triangle-mirror-app",
  "version": "1.0.0",
  "description": "Triangle Mirror - Auto-highlighting similar triangle structures for Moodle LMS",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "build": "npm run client:build && npm run server:build",
    "client:build": "cd client && npm run build",
    "server:build": "cd server && npm run build",
    "start": "cd server && npm start",
    "test": "npm run server:test && npm run client:test",
    "server:test": "cd server && npm test",
    "client:test": "cd client && npm test"
  },
  "keywords": [
    "moodle",
    "geometry",
    "triangle",
    "education",
    "lms"
  ],
  "author": "KAIST Touch Math Academy",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
