# Geo Spiral Standalone - Backend Environment

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=mysql
DB_PORT=3306
DB_USER=geospiral
DB_PASSWORD=geospiral123
DB_NAME=geospiral_db

# JWT Authentication
JWT_SECRET=geospiral-secret-key-please-change-in-production-to-long-random-string
JWT_EXPIRES_IN=7d

# Features
ENABLE_GUEST_MODE=true
ENABLE_RECOMMENDATIONS=true
