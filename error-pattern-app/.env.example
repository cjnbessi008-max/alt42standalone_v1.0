# Environment Configuration for Error Pattern Analysis System

# Node Environment
NODE_ENV=production

# Database Configuration (MySQL 5.7)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=error_pattern_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_use_long_random_string
JWT_EXPIRES_IN=7d

# Moodle Integration
MOODLE_URL=https://your-moodle-instance.com
MOODLE_WS_TOKEN=your_moodle_webservice_token_here
MOODLE_SERVICE_NAME=error_pattern_service

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# CORS Settings
CORS_ORIGIN=http://localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
