# Balance Scale App - Environment Configuration Example
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_NAME=balance_scale
DB_USER=root
DB_PASS=

# Moodle Integration (Optional)
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=your_moodle_webservice_token_here
MOODLE_SERVICE=balance_scale_service

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Security (Change in production!)
APP_SECRET=change_this_to_random_string_in_production
