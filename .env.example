# Transform Scene Environment Configuration
# Copy this file to .env and update with your settings

# Moodle API Configuration
REACT_APP_MOODLE_API_URL=http://localhost/moodle/api
REACT_APP_MOODLE_WS_TOKEN=your_webservice_token_here

# Application Settings
REACT_APP_DEBUG_MODE=false
REACT_APP_API_TIMEOUT=30000
REACT_APP_ENABLE_ANALYTICS=false

# Feature Flags
REACT_APP_ENABLE_HINTS=true
REACT_APP_ENABLE_PROGRESS_TRACKING=true
REACT_APP_MAX_ATTEMPTS=3

# UI Settings
REACT_APP_ANIMATION_DURATION=2000
REACT_APP_THEME_COLOR=#667eea
REACT_APP_LANGUAGE=ko

# Performance Settings
REACT_APP_CACHE_ENABLED=true
REACT_APP_CACHE_TTL=3600

# Development Settings (only for development)
REACT_APP_MOCK_API=false
REACT_APP_LOG_LEVEL=info
