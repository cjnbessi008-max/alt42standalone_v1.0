# LMS Hint System Environment Variables
# Copy this file to .env and fill in your actual values

# Anthropic API Key (Required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Secret key for JWT tokens (Required)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here

# Database Configuration
DATABASE_URL=postgresql://hint_user:hint_password@localhost:5432/hint_system

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Settings
DEBUG=False
APP_NAME=LMS Hint System
APP_VERSION=1.0.0

# Hint Generation Settings
MAX_HINT_STEPS=5
HINT_MODEL=claude-3-5-sonnet-20241022
HINT_TEMPERATURE=0.7
MAX_TOKENS=500

# LMS Integration (LTI 1.3) - Optional
# Fill these in when integrating with an actual LMS
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_ISS=
LTI_AUTH_TOKEN_URL=
LTI_AUTH_LOGIN_URL=
LTI_KEYSET_URL=
