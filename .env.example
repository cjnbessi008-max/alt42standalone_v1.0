# Moodle 데이터베이스 연결 설정
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASS=your_password_here

# Moodle 테이블 접두사 (기본값: mdl_)
MOODLE_TABLE_PREFIX=mdl_

# Moodle Web Services 설정
MOODLE_WS_URL=http://localhost/moodle/webservice/rest/server.php
MOODLE_WS_TOKEN=

# Moodle 시스템 경로
MOODLE_DIR_ROOT=/var/www/moodle
MOODLE_DATA_ROOT=/var/moodledata

# 연동 모드: DIRECT (직접 DB), API (Web Services), HYBRID (둘 다)
INTEGRATION_MODE=HYBRID

# 동기화 설정
SYNC_INTERVAL=300
ENABLE_AUTO_SYNC=true

# 디버그 모드
DEBUG_MODE=false
LOG_LEVEL=INFO

# 타임존
TIMEZONE=Asia/Seoul
