# Inequality Arrow App - Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
DB_ROOT_PASSWORD=rootpassword
DB_HOST=localhost
DB_NAME=inequality_arrow_db
DB_USER=inequality_user
DB_PASSWORD=secure_password_here

# Moodle Integration
MOODLE_URL=https://your-moodle-site.com
MOODLE_TOKEN=your_moodle_webservice_token

# Application Settings
APP_ENV=production
APP_DEBUG=false
TIMEZONE=Asia/Seoul

# Security
SESSION_SECRET=generate_random_secret_key_here

# CORS Settings
ALLOWED_ORIGINS=http://localhost,https://your-domain.com
