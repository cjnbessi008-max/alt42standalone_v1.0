# Learning Summary System - Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration (MySQL 5.7)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=learning_summary
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Moodle Configuration
MOODLE_URL=http://localhost/moodle
MOODLE_WS_TOKEN=
MOODLE_WS_SERVICE=moodle_mobile_app

# Anthropic Claude API Configuration
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4000
CLAUDE_TEMPERATURE=0.7

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Seoul
APP_LANGUAGE=ko

# AI Summary Settings
ENABLE_AI_SUMMARIES=true
SUMMARY_LANGUAGE=ko
MAX_SUMMARY_LENGTH=500

# Session Settings
SESSION_LIFETIME=7200
SESSION_COOKIE_NAME=learning_summary_session

# Security
SESSION_SECRET=change_this_to_random_string
ENCRYPTION_KEY=change_this_to_32_character_key

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log
