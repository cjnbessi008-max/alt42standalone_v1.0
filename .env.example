# Backend Environment Variables

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/emotion_detection
POSTGRES_USER=emotion_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=emotion_detection

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=4

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI/LLM Configuration (optional - for enhanced emotion analysis)
ANTHROPIC_API_KEY=your_claude_api_key_here
USE_AI_ANALYSIS=false

# LMS Integration (optional)
LMS_TYPE=custom
LMS_URL=https://your-lms-url.com
LMS_API_KEY=your_lms_api_key
LMS_WEBHOOK_URL=https://your-lms-url.com/webhooks/emotion-alerts
LMS_COURSE_ID=your_course_id

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/

# Security
SECRET_KEY=change_this_to_a_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Feature Flags
ENABLE_BEHAVIOR_TRACKING=true
ENABLE_LMS_INTEGRATION=true
ENABLE_AI_ANALYSIS=false

# Thresholds
EMOTION_ALERT_THRESHOLD=0.7
INTERVENTION_THRESHOLD=0.8
