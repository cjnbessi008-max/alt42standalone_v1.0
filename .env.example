# Environment Configuration for AI Education System
# Copy this file to .env and configure with your actual values

# =============================================================================
# Moodle LMS Integration Configuration
# =============================================================================

# Moodle base URL (without trailing slash)
# Example: https://moodle.kaist.ac.kr
MOODLE_BASE_URL=https://your-moodle-site.com

# Moodle Web Services Token
# Generate this from: Site Administration > Plugins > Web services > Manage tokens
MOODLE_WS_TOKEN=your_webservice_token_here

# Moodle API timeout (seconds)
MOODLE_API_TIMEOUT=30

# =============================================================================
# Database Configuration (MySQL 5.7)
# =============================================================================

# MySQL connection details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alt42_moodle_integration
DB_USER=alt42_app
DB_PASSWORD=your_secure_password_here

# Database pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# API Configuration
# =============================================================================

# API server settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# CORS settings (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# API rate limiting
API_RATE_LIMIT=100  # requests per hour per IP

# =============================================================================
# Application Configuration
# =============================================================================

# Default language (ko or en)
DEFAULT_LANGUAGE=ko

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/app.log

# =============================================================================
# Security Configuration
# =============================================================================

# Secret key for encryption (generate using: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_minimum_32_characters

# JWT settings (if using authentication)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# Redis Configuration (Optional - for caching)
# =============================================================================

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache TTL (seconds)
CACHE_TTL=3600

# =============================================================================
# AI/LLM Configuration (Future)
# =============================================================================

# Claude API (Anthropic)
# CLAUDE_API_KEY=your_claude_api_key
# CLAUDE_MODEL=claude-3-sonnet-20240229

# =============================================================================
# Monitoring & Analytics (Optional)
# =============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn

# Google Analytics tracking ID
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# =============================================================================
# Development Settings
# =============================================================================

# Enable debug mode (DO NOT use in production)
DEBUG=false

# Enable SQL query logging
SQL_ECHO=false

# Enable auto-reload on code changes
AUTO_RELOAD=true

# =============================================================================
# Moodle 3.7 Specific Settings
# =============================================================================

# PHP version compatibility
PHP_VERSION=7.1.9

# MySQL version
MYSQL_VERSION=5.7

# Moodle version
MOODLE_VERSION=3.7

# Moodle web services protocol (rest or soap)
MOODLE_WS_PROTOCOL=rest

# Maximum questions to fetch per request
MAX_QUESTIONS_PER_REQUEST=100

# =============================================================================
# Feature Flags
# =============================================================================

# Enable reverse problem reconstruction
FEATURE_REVERSE_RECONSTRUCTION=true

# Enable batch processing
FEATURE_BATCH_PROCESSING=true

# Enable complexity caching
FEATURE_COMPLEXITY_CACHE=true

# Enable database persistence
FEATURE_DATABASE_PERSISTENCE=false
