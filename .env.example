# Application
APP_NAME="LMS Concept System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_concept_system
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=3600

# Moodle LTI
LTI_CONSUMER_KEY=moodle_key_12345
LTI_CONSUMER_SECRET=moodle_secret_67890

# OpenAI (Optional for advanced AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Logging
LOG_LEVEL=debug
LOG_PATH=logs/app.log

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
