# ============================================================================
# LMS Integration Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://alt42:your_password@localhost:5432/alt42_lms
ENCRYPTION_KEY=your_fernet_encryption_key_here

# ============================================================================
# Moodle LMS Configuration
# ============================================================================
MOODLE_URL=https://lms.kaist.ac.kr
MOODLE_WS_TOKEN=your_moodle_webservice_token_here
MOODLE_COURSE_ID=123

# ============================================================================
# Redis Configuration (for Celery)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# AI Configuration (Anthropic Claude)
# ============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-3-sonnet-20240229
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.3

# ============================================================================
# Scheduler Configuration
# ============================================================================
# Daily evaluation time (hour in 24h format, KST timezone)
EVALUATION_SCHEDULE_HOUR=2
# Number of responses to process in each batch
BATCH_SIZE=50
# Maximum retry attempts for failed evaluations
MAX_RETRIES=3
# Days to look back for new responses
LOOKBACK_DAYS=1
# Maximum responses to evaluate per job
MAX_RESPONSES=1000

# ============================================================================
# Email/Notification Configuration
# ============================================================================
ADMIN_EMAIL=admin@kaist.ac.kr
SMTP_HOST=smtp.kaist.ac.kr
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true

# ============================================================================
# Application Configuration
# ============================================================================
ENVIRONMENT=development  # development, production, testing
DEBUG=true
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# Security Configuration
# ============================================================================
SECRET_KEY=your_secret_key_for_jwt_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://kaist.ac.kr

# ============================================================================
# Monitoring & Analytics
# ============================================================================
# Optional: Sentry for error tracking
SENTRY_DSN=

# Optional: Application Insights
APPINSIGHTS_INSTRUMENTATION_KEY=

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_REAL_TIME_EVALUATION=false
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_WEBHOOK=false

# ============================================================================
# Performance Tuning
# ============================================================================
# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Celery workers
CELERY_WORKER_CONCURRENCY=4

# API rate limiting
RATE_LIMIT_PER_HOUR=100

# ============================================================================
# Development/Testing
# ============================================================================
# Set to true to run tasks synchronously (for debugging)
CELERY_TASK_ALWAYS_EAGER=false

# Mock Moodle API responses (for testing without real Moodle)
MOCK_MOODLE_API=false

# ============================================================================
# File Storage (optional, for future use)
# ============================================================================
# AWS S3 or MinIO for storing evaluation artifacts
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-northeast-2

# ============================================================================
# Notes
# ============================================================================
#
# To generate ENCRYPTION_KEY (for Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# To generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# To get Moodle Web Service Token:
#   1. Login to Moodle as admin
#   2. Go to Site Administration > Plugins > Web services > Manage tokens
#   3. Create a token for your user
#   4. Copy the token here
#
# To get Anthropic API Key:
#   1. Go to https://console.anthropic.com/
#   2. Create an API key
#   3. Copy the key here
#
# ============================================================================
