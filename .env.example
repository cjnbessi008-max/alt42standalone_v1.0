# Color Pattern Classifier - Environment Configuration
# Copy this file to .env and configure your settings

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_SECRET_KEY=change-this-secret-key-in-production
ALLOWED_ORIGINS=*

# Database Configuration (MySQL 5.7)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=color_pattern_db
DB_USER=root
DB_PASS=

# Moodle Integration Settings
MOODLE_URL=http://localhost/moodle
MOODLE_WS_TOKEN=your-web-service-token-here
MOODLE_VERIFY_SSL=true

# Logging
LOG_LEVEL=info
