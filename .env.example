# Environment Configuration for Sequence Puzzle
# Copy this file to .env and update with your settings

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sequence_puzzle
DB_USER=root
DB_PASS=

# Moodle Configuration
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=your_moodle_webservice_token_here

# LTI Configuration
LTI_KEY=sequence_puzzle_key
LTI_SECRET=change_this_to_secure_random_string

# Application Configuration
APP_URL=http://localhost
DEBUG_MODE=true

# Security
ALLOWED_ORIGINS=*

# Session
SESSION_TIMEOUT=3600
