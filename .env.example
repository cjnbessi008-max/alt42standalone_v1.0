# Database Configuration (MySQL 5.7)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=thinking_patterns
DB_USER=root
DB_PASS=

# Moodle Configuration (Moodle 3.7)
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=your_web_service_token_here
MOODLE_WS_USER=webservice_user

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Logging
LOG_LEVEL=debug
LOG_FILE=/var/log/thinking-patterns/app.log

# API Settings
API_BASE_URL=http://localhost:8000/api
