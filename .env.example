# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=triangle_mirror
DB_USER=postgres
DB_PASSWORD=your_password

# Moodle LMS Integration
MOODLE_URL=http://your-moodle-instance.com
MOODLE_API_TOKEN=your_moodle_webservice_token
MOODLE_SERVICE_NAME=triangle_mirror_service

# Legacy MySQL Connection (for existing Moodle database)
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=your_mysql_password

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
