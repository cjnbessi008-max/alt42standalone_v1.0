# Shift Trail Application Configuration
# Copy this file to .env and configure your environment

# Application
APP_ENV=development
APP_NAME="Shift Trail"

# Database Configuration (MySQL 5.7)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shift_trail_db
DB_USER=root
DB_PASS=

# Moodle Integration (Moodle 3.7)
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=your_moodle_webservice_token_here
MOODLE_VERSION=3.7

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_PATH=/var/log/shift_trail/

# Session Configuration
SESSION_TIMEOUT=3600

# Trail Settings (defaults)
TRAIL_DEFAULT_COLOR=#3498db
TRAIL_DEFAULT_WIDTH=3
TRAIL_ANIMATION_DURATION=1000
TRAIL_MAX_POINTS=1000
TRAIL_SAMPLING_INTERVAL=50

# Canvas Settings
GRID_SIZE=20
CANVAS_WIDTH=600
CANVAS_HEIGHT=600

# Smartphone Display
SMARTPHONE_WIDTH=375
SMARTPHONE_HEIGHT=667
SMARTPHONE_SCALE=1.0

# Problem Settings
MAX_ATTEMPTS=3
DEFAULT_TIME_LIMIT=300
DEFAULT_POINTS=10

# Development Settings
DISPLAY_ERRORS=true
DEBUG_MODE=true
