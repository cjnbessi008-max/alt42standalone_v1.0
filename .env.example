# AI Education Pipeline - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
APP_ENV=development
APP_URL=https://ai-pipeline.kaist.ac.kr
APP_DEBUG=true
LOG_LEVEL=info

# ============================================
# Moodle Integration
# ============================================

# Moodle Instance URL
MOODLE_URL=https://lms.kaist.ac.kr

# Moodle Web Services Token
# Generate at: Site administration → Plugins → Web services → Manage tokens
MOODLE_WS_TOKEN=your_moodle_webservice_token_here

# ============================================
# LTI Configuration
# ============================================

# LTI Consumer Key (must match Moodle External Tool settings)
# Configure in Moodle: Site administration → Plugins → Activity modules → External tool
LTI_CONSUMER_KEY=kaist_aipipeline

# LTI Shared Secret (generate a strong random string)
# Use: openssl rand -base64 32
LTI_SHARED_SECRET=your_lti_shared_secret_here

# ============================================
# Database Configuration
# ============================================

# AI Pipeline Database (MySQL 5.7+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aipipeline
DB_USER=aipipeline_user
DB_PASS=your_database_password_here

# Moodle Database (Read-only access recommended)
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_readonly
MOODLE_DB_PASS=your_moodle_db_password_here

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# SSO Configuration
# ============================================

# JWT Secret for token-based authentication
# Generate: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here

# SAML Configuration (if using SAML SSO)
SAML_SP_ENTITY_ID=https://ai-pipeline.kaist.ac.kr/saml/metadata
SAML_IDP_ENTITY_ID=https://lms.kaist.ac.kr/auth/saml2/idp/metadata.php

# ============================================
# Email Configuration
# ============================================
ADMIN_EMAIL=admin@kaist.ac.kr
SMTP_HOST=smtp.kaist.ac.kr
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kaist.ac.kr

# ============================================
# Security Settings
# ============================================

# Enable IP Whitelist (true/false)
IP_WHITELIST_ENABLED=false

# Allowed IP Addresses (comma-separated)
ALLOWED_IPS=192.168.1.100,10.0.0.50

# ============================================
# Claude AI API (from PRD)
# ============================================
CLAUDE_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4000

# ============================================
# Monitoring & Logging
# ============================================
SENTRY_DSN=
ENABLE_QUERY_LOG=false
ENABLE_PERFORMANCE_LOG=true

# ============================================
# Feature Flags
# ============================================
ENABLE_DEEP_LINKING=true
ENABLE_GRADE_PASSBACK=true
ENABLE_AUTO_SYNC=true
