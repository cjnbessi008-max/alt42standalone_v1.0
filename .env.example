# Server Configuration
PORT=3000
NODE_ENV=development

# Moodle Database Configuration (MySQL 5.7)
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=your_password_here
MOODLE_DB_NAME=moodle

# Moodle Web Services Configuration
MOODLE_URL=http://localhost/moodle
MOODLE_WS_TOKEN=your_webservice_token_here

# Brain Monitor Thresholds
BRAIN_SESSION_DURATION=2700        # 45분 (초 단위)
BRAIN_ACTIVITY_FREQUENCY=30        # 30 activities per 10 minutes
BRAIN_ERROR_RATE=0.5               # 50% 오답률
BRAIN_RESPONSE_TIME=15             # 15초 평균 응답 시간
BRAIN_COGNITIVE_LOAD=0.75          # 75% 인지 부하 임계값

# Brain Monitor Check Interval
BRAIN_CHECK_INTERVAL=60000         # 1분 (밀리초)

# Activity Sync Interval (Moodle DB → Brain Monitor)
SYNC_INTERVAL=30000                # 30초 (밀리초)

# Frontend Configuration
REACT_APP_WS_URL=ws://localhost:3000
REACT_APP_API_URL=http://localhost:3000/api
