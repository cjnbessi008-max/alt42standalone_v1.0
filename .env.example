# Impossible Shadow - Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=5000

# MySQL Database Configuration (MySQL 5.7)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=impossible_shadow

# Moodle LMS Integration (Moodle 3.7)
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=your_moodle_token_here

# PHP Configuration (PHP 7.1.9)
# Note: PHP is used by Moodle, not directly by this application

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Logging
LOG_LEVEL=info
