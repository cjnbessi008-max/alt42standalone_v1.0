# Database Configuration (MySQL 5.7 - Moodle Compatible)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=peak_thinking_db
DB_USER=peak_user
DB_PASSWORD=peak_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Moodle Integration
MOODLE_URL=https://your-moodle-instance.com
MOODLE_API_TOKEN=your_moodle_api_token
MOODLE_VERSION=3.7

# Backend Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production

# Analytics Engine
ANALYTICS_API_URL=http://localhost:8001

# Frontend Configuration
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# Peak Thinking Algorithm Parameters
PEAK_MIN_DURATION_SEC=30
PEAK_MAX_DURATION_SEC=300
PEAK_MIN_EVENT_RATE=0.5
PEAK_MAX_EVENT_RATE=3.0
PEAK_MAX_IDLE_SEC=10
PEAK_EFFICIENCY_THRESHOLD=0.6
