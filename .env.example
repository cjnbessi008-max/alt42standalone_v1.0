# LMS API Configuration
VITE_LMS_API_URL=http://localhost:8080/api

# Moodle Configuration
VITE_MOODLE_URL=https://your-moodle-instance.com
VITE_MOODLE_TOKEN=your_moodle_token_here

# MySQL Database Configuration (Backend)
# These are used by the PHP backend that connects to MySQL
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=moodle
# DB_USER=moodle_user
# DB_PASSWORD=your_password

# Development Mode
VITE_DEV_MODE=true
VITE_USE_MOCK_DATA=true
