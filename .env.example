# Environment Configuration for Wrong Move Alert System

# ===== Node Environment =====
NODE_ENV=development

# ===== Database Configuration (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wrongmove_db
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Backend Configuration =====
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# ===== Frontend Configuration =====
FRONTEND_PORT=3000
REACT_APP_BACKEND_URL=http://localhost:3001

# ===== Moodle Integration (Optional) =====
# Moodle LMS base URL (without trailing slash)
MOODLE_BASE_URL=https://moodle.example.com

# Moodle Web Services API Token
# Generate this from: Moodle > Site Administration > Plugins > Web Services > Manage Tokens
MOODLE_API_TOKEN=your_moodle_api_token_here

# Moodle Course ID for syncing problems
MOODLE_COURSE_ID=course_math_grade3

# ===== pgAdmin Configuration (Optional) =====
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ===== Logging Configuration =====
LOG_LEVEL=info

# ===== Session Configuration =====
SESSION_SECRET=your_secure_session_secret_here

# ===== CORS Configuration =====
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== Wrong Move Alert Configuration =====
# Duration of crack effect in milliseconds
CRACK_EFFECT_DURATION_MS=2000

# Severity thresholds
WRONG_MOVE_LOW_THRESHOLD=1
WRONG_MOVE_MEDIUM_THRESHOLD=3
WRONG_MOVE_HIGH_THRESHOLD=5

# ===== Production Settings =====
# Uncomment and configure for production deployment

# DB_HOST=your-production-db-host
# DB_PORT=5432
# DB_NAME=wrongmove_production
# DB_USER=wrongmove_user
# DB_PASSWORD=your_secure_db_password

# BACKEND_PORT=3001
# FRONTEND_URL=https://wrongmove.yourdomain.com

# MOODLE_BASE_URL=https://moodle.kaist.ac.kr
# MOODLE_API_TOKEN=your_production_moodle_token
