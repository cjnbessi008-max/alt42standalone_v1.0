# Chaos Harmony Environment Configuration
# Copy this file to .env and update with your actual values

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=chaos_user
MYSQL_PASSWORD=chaos_pass

# Moodle LMS Configuration
# Get the web service token from Moodle: Site administration > Plugins > Web services > Manage tokens
MOODLE_URL=http://your-moodle-server.com/moodle
MOODLE_TOKEN=your_moodle_web_service_token_here

# CORS Configuration
# Set to specific domain in production (e.g., https://yourdomain.com)
ALLOWED_ORIGINS=*

# Application Settings
# Set to 'production' in production environment
APP_ENV=development
