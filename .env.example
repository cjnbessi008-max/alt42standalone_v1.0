# Condition Morph Environment Variables

# ===== Database Configuration =====
DATABASE_URL=postgresql://alt42:secure_password@localhost:5432/alt42_condition_morph
POSTGRES_DB=alt42_condition_morph
POSTGRES_USER=alt42
POSTGRES_PASSWORD=secure_password

# ===== Redis Configuration =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===== Moodle Integration =====
# Moodle Web Services API
MOODLE_URL=https://lms.kaist.ac.kr
MOODLE_TOKEN=your_webservice_token_here

# Moodle Database (Direct Connection - Optional)
MOODLE_DB_HOST=moodle_db_host
MOODLE_DB_PORT=3306
MOODLE_DB_USER=readonly_user
MOODLE_DB_PASSWORD=password
MOODLE_DB_NAME=moodle

# ===== Application Settings =====
# 로그 레벨 (debug, info, warning, error)
LOG_LEVEL=info

# Morphing 설정
MIN_CORRECT_THRESHOLD=3
MIN_WRONG_THRESHOLD=3
TIME_THRESHOLD_SECONDS=120
MASTERY_THRESHOLD=0.8

# WebSocket 설정
WS_HEARTBEAT_INTERVAL=30

# ===== Security =====
JWT_SECRET=your_jwt_secret_key_here_change_in_production
ENCRYPTION_KEY=your_encryption_key_here_32_characters

# ===== Feature Flags =====
ENABLE_AUTO_MORPH=true
ENABLE_MANUAL_MORPH=true
ENABLE_MOODLE_SYNC=true
MORPH_DELAY_MS=500

# ===== Frontend Configuration =====
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000
REACT_APP_ENABLE_DEBUG=false

# ===== Production Settings (주석 제거하여 활성화) =====
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
