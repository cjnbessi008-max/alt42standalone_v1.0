# Data Shuffle - Environment Configuration
# Copy this file to .env and update with your settings

# ============================================
# Database Configuration (Data Shuffle DB)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=data_shuffle
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ============================================
# Moodle Database Configuration
# ============================================
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=
MOODLE_DB_PREFIX=mdl_

# ============================================
# Moodle Web Services
# ============================================
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=your_moodle_webservice_token_here

# ============================================
# Application Settings
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Shuffle Settings
DEFAULT_CACHE_DURATION=3600
DEFAULT_SALT=datashuffle_v1_2025

# ============================================
# Security
# ============================================
SESSION_SECRET=change_this_to_random_string
API_RATE_LIMIT=100

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_FILE=/var/log/data_shuffle.log
