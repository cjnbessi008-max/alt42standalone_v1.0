# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_education

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LTI Configuration
LTI_ISSUER=https://your-lms.example.com
LTI_CLIENT_ID=your-client-id
LTI_DEPLOYMENT_ID=your-deployment-id
LTI_PLATFORM_PUBLIC_KEY=
LTI_PRIVATE_KEY_PATH=./keys/private.key

# Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
