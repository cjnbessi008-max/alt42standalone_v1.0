# Environment Configuration for Reasoning Feedback System

# ============= Application =============
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ============= Database =============
DATABASE_URL=postgresql://reasoning_user:reasoning_pass@localhost:5432/reasoning_db

# For production, use a more secure connection string:
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ============= AI Service =============
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============= CORS =============
# Comma-separated list of allowed origins
# For development: http://localhost:3000,http://localhost:5173
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ============= Security (Optional) =============
# JWT secret for authentication (if implementing auth)
# JWT_SECRET=your_secret_key_here
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=60

# ============= Moodle Integration (Optional) =============
# MOODLE_URL=https://your-moodle-instance.com
# MOODLE_API_TOKEN=your_moodle_token_here

# ============= Logging =============
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
