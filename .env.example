# ========================================
# ALT42 Education System - Environment Configuration
# ========================================

# Database Configuration (MySQL 5.7)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alt42_education
DB_USER=your_db_user
DB_PASS=your_db_password

# Moodle LTI Configuration
LTI_CONSUMER_KEY=kaist_lti_key_2025
LTI_SHARED_SECRET=your_shared_secret_here_change_this

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Session Configuration
SESSION_TIMEOUT=3600
SESSION_DRIVER=file

# Moodle Integration
MOODLE_URL=https://moodle.kaist.ac.kr
GRADE_SYNC_ENABLED=true

# Security
SECRET_KEY=your_secret_key_here_change_this

# Logging
LOG_LEVEL=info
LOG_PATH=/var/log/alt42/

# Performance
CACHE_ENABLED=true
CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30
