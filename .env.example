# Moodle LMS Configuration
# Copy this file to .env and update with your Moodle instance details

# Moodle base URL (without trailing slash)
REACT_APP_MOODLE_URL=http://localhost/moodle

# Moodle Web Service Token
# Generate this in Moodle: Site administration > Plugins > Web services > Manage tokens
REACT_APP_MOODLE_TOKEN=your_moodle_webservice_token_here

# Moodle Course ID (optional)
REACT_APP_MOODLE_COURSE_ID=1

# Enable demo mode (uses demo problems instead of Moodle)
REACT_APP_DEMO_MODE=true
