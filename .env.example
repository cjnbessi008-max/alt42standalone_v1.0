# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/growth_log_db
DATABASE_ECHO=false  # Set to true for SQL query logging

# AI Service
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LMS Integration - Canvas
CANVAS_INSTANCE_URL=https://canvas.your-institution.edu
CANVAS_API_TOKEN=your-canvas-api-token

# LMS Integration - Moodle
MOODLE_INSTANCE_URL=https://moodle.your-institution.edu
MOODLE_WS_TOKEN=your-moodle-ws-token

# Redis (Optional - for caching and task queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Application Settings
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Growth Log Settings
DEFAULT_GROWTH_SCORE_WEIGHT=0.4
DEFAULT_EFFORT_SCORE_WEIGHT=0.3
DEFAULT_PROGRESS_SCORE_WEIGHT=0.3

# LMS Sync Settings
LMS_SYNC_ENABLED=true
LMS_SYNC_BATCH_SIZE=100
LMS_SYNC_RETRY_ATTEMPTS=3
LMS_SYNC_RETRY_DELAY_SECONDS=5
