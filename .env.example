# Environment Variables Example
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_education
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_education
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# LMS Integration (Future)
# KAIST_SSO_CLIENT_ID=your_client_id
# KAIST_SSO_CLIENT_SECRET=your_client_secret
# KAIST_SSO_CALLBACK_URL=http://localhost:8000/auth/callback

# Claude API (Future - for AI generation)
# CLAUDE_API_KEY=your_api_key
# CLAUDE_MODEL=claude-3-sonnet-20240229

# Redis (Future - for caching)
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
