# Moodle LMS Configuration
# Copy this file to .env and fill in your values

# Moodle Site URL (without trailing slash)
VITE_MOODLE_URL=https://your-moodle-site.com

# Moodle Web Service Token
# Generate this from: Site administration > Server > Web services > Manage tokens
VITE_MOODLE_WS_TOKEN=your_web_service_token_here

# Optional: API timeout in milliseconds (default: 10000)
VITE_API_TIMEOUT=10000

# Optional: Enable development mode (shows mock data)
VITE_DEV_MODE=true
