# Geo Spiral - Environment Configuration

# Database Configuration (MySQL 5.7)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moodle_geospiral
DB_USER=moodle
DB_PASSWORD=your_password_here

# Moodle Configuration
MOODLE_VERSION=3.7
MOODLE_URL=http://localhost/moodle
MOODLE_DATA_PATH=/var/moodledata

# PHP Configuration
PHP_VERSION=7.1.9
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300

# Application Configuration
APP_NAME=GeoSpiral
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000

# Virtual Phone Display
PHONE_SCREEN_WIDTH=375
PHONE_SCREEN_HEIGHT=667
PHONE_POSITION=bottom-right

# Spiral Visualization Settings
SPIRAL_TYPE=logarithmic
SPIRAL_ANIMATION_SPEED=1000
SPIRAL_MAX_ITERATIONS=100
