# Application Environment
APP_ENV=development
APP_NAME="Incorrect Solutions Comparison System"

# Database Configuration (MySQL 5.7)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=incorrect_solutions
DB_USER=root
DB_PASS=

# API Configuration
API_BASE_URL=http://localhost/api

# Moodle Integration (Moodle 3.7)
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=
MOODLE_SYNC_ENABLED=false

# AI Service (Anthropic Claude)
ANTHROPIC_API_KEY=your_api_key_here
AI_MODEL=claude-3-sonnet-20240229

# Security
ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=info
