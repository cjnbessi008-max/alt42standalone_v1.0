# Application Settings
APP_NAME="Deviation Breeze"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=deviation_breeze
DB_USERNAME=root
DB_PASSWORD=

# Moodle Integration
MOODLE_URL=https://your-moodle-site.com
MOODLE_WS_TOKEN=your_web_service_token_here
MOODLE_WS_FUNCTION_PREFIX=core_

# Security
SESSION_SECRET=change_this_to_random_string
JWT_SECRET=change_this_to_another_random_string

# Cache Settings
CACHE_DRIVER=file
CACHE_TTL=300

# Logging
LOG_LEVEL=debug
LOG_PATH=logs/app.log
