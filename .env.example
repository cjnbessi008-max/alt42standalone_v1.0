# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dmn_monitoring
POSTGRES_USER=dmn_user
POSTGRES_PASSWORD=changeme

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Gateway Configuration
API_GATEWAY_PORT=3000
NODE_ENV=development
JWT_SECRET=your-secret-key-change-this-in-production

# DMN Service Configuration
DMN_SERVICE_PORT=8000
DMN_SERVICE_HOST=localhost

# Moodle Integration
MOODLE_URL=http://your-moodle-instance.com
MOODLE_API_TOKEN=your-moodle-api-token

# WebSocket Configuration
WS_UPDATE_INTERVAL=5000

# DMN Analysis Configuration
DMN_ANALYSIS_WINDOW=30
DMN_THRESHOLD_DEEP_FOCUS=0.8
DMN_THRESHOLD_ACTIVE=0.6
DMN_THRESHOLD_WANDERING=0.4

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info
