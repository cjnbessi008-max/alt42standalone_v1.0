# Environment Configuration for Impairment Detection System
# Copy this file to .env and update with your actual values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=impairment-detection-system
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# MOODLE DATABASE (MySQL 5.7) - READ ONLY
# ============================================================================
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=readonly_analytics
MOODLE_DB_PASSWORD=your_secure_password_here
MOODLE_DB_SSL=true

# ============================================================================
# ANALYTICS DATABASE (PostgreSQL 15+)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=impairment_analytics
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SSL_MODE=prefer  # disable, allow, prefer, require, verify-ca, verify-full

# Database connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ============================================================================
# REDIS (Caching & Task Queue)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# ============================================================================
# DETECTION ENGINE SETTINGS
# ============================================================================
# Assessment interval (seconds)
ASSESSMENT_INTERVAL=30

# Session timeout (minutes of inactivity = session end)
SESSION_TIMEOUT=15

# Minimum interactions needed for baseline calculation
MIN_BASELINE_INTERACTIONS=20

# Minimum interactions needed for assessment
MIN_ASSESSMENT_INTERACTIONS=5

# Detection thresholds
THRESHOLD_ACCURACY_DECLINE=0.20  # 20% decline triggers detection
THRESHOLD_RESPONSE_TIME_INCREASE=1.50  # 1.5x slower triggers detection
THRESHOLD_CARELESS_ERROR_RATE=0.30  # 30% careless errors triggers detection
THRESHOLD_SESSION_DURATION_WARNING=5400  # 90 minutes (in seconds)

# Alert thresholds (impairment scores)
ALERT_LEVEL_EARLY_WARNING=31
ALERT_LEVEL_MODERATE=51
ALERT_LEVEL_SEVERE=71

# ============================================================================
# API SETTINGS
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # Auto-reload on code changes (development only)

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT settings
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API key for service-to-service communication
API_KEY=your_api_key_here

# ============================================================================
# WEBSOCKET SETTINGS
# ============================================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/ws
WEBSOCKET_PING_INTERVAL=25
WEBSOCKET_PING_TIMEOUT=60

# ============================================================================
# CELERY TASK QUEUE
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Task schedules (in seconds)
TASK_COLLECT_INTERVAL=60  # Collect data from Moodle every 60 seconds
TASK_ASSESS_INTERVAL=30  # Run impairment assessments every 30 seconds
TASK_CLEANUP_INTERVAL=3600  # Cleanup old data every hour

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Logging
LOG_FORMAT=json  # json or text
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=10485760  # 10MB
LOG_FILE_BACKUP_COUNT=5

# ============================================================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================================================
EMAIL_ENABLED=false
EMAIL_BACKEND=smtp  # smtp, sendgrid, ses
EMAIL_FROM=noreply@your-institution.edu
EMAIL_FROM_NAME=Impairment Detection System

# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# SendGrid settings
SENDGRID_API_KEY=

# AWS SES settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ============================================================================
# FRONTEND SETTINGS
# ============================================================================
FRONTEND_URL=http://localhost:3000

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Auto-reload on file changes
AUTO_RELOAD=true

# Mock data generation for testing
MOCK_DATA_ENABLED=false
MOCK_STUDENT_COUNT=50

# SQL query logging
SQL_ECHO=false  # Set to true to log all SQL queries

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================
# In production, ensure:
# - DEBUG=false
# - APP_ENV=production
# - Strong JWT_SECRET_KEY
# - Strong database passwords
# - CORS_ORIGINS limited to your domain
# - SSL/TLS enabled for all databases
# - Sentry DSN configured
# - Email notifications enabled
# - AUTO_RELOAD=false
# - SQL_ECHO=false
