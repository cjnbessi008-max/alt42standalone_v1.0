# Frontend Environment Configuration
# Copy this file to .env and fill in your actual values

# API Configuration
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_WS_URL=ws://localhost:8000

# Feature Flags
REACT_APP_ENABLE_EMOTION_DETECTION=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_SHOW_CONNECTION_STATUS=true

# Behavior Tracking Configuration
REACT_APP_BEHAVIOR_BATCH_SIZE=10
REACT_APP_BEHAVIOR_INTERVAL_MS=5000
REACT_APP_TRACK_CLICKS=true
REACT_APP_TRACK_KEYBOARD=true
REACT_APP_TRACK_SCROLL=true
REACT_APP_TRACK_FOCUS=true
REACT_APP_TRACK_ERRORS=true

# Color Mode Settings
REACT_APP_DEFAULT_COLOR_MODE=neutral
REACT_APP_AUTO_MODE_ENABLED=true
REACT_APP_DEFAULT_SENSITIVITY=medium

# UI Configuration
REACT_APP_COLOR_SELECTOR_POSITION=bottom-right
REACT_APP_COLOR_SELECTOR_EXPANDED=false

# Development
REACT_APP_DEBUG_MODE=false
