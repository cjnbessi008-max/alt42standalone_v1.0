# Mental Care Messaging System - Frontend Environment Variables

# API Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# Default Settings
REACT_APP_DEFAULT_LANGUAGE=ko
REACT_APP_MAX_VISIBLE_MESSAGES=3
REACT_APP_AUTO_HIDE_DELAY=0

# Feature Flags
REACT_APP_ENABLE_WEBSOCKET=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_SOUND=true
REACT_APP_NOTIFICATION_VOLUME=0.3

# Development
REACT_APP_DEBUG=true
REACT_APP_SHOW_CONNECTION_STATUS=true

# Analytics (optional)
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_MIXPANEL_TOKEN=

# Environment
REACT_APP_ENV=development
