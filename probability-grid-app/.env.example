# Probability Grid Application Configuration
# Copy this file to .env and update with your values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=probability_grid
DB_USER=root
DB_PASS=

# LTI Configuration
LTI_CONSUMER_KEY=moodle_probability_grid
LTI_SHARED_SECRET=change_this_secret_key_to_something_secure

# Application Configuration
APP_BASE_URL=http://localhost/probability-grid-app
TOOL_URL=http://localhost/probability-grid-app/moodle-plugin/lti_handler.php
DEBUG_MODE=false

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost,http://your-moodle-domain.com
