# Number Constellation App - Environment Variables

# Database Configuration
DB_HOST=mysql
DB_NAME=number_constellation
DB_USER=numconst
DB_PASS=numconst123

# MySQL Root Password
MYSQL_ROOT_PASSWORD=rootpassword

# API Configuration
API_KEY=your-secret-api-key-here

# CORS Configuration
CORS_ORIGIN=*

# Moodle Configuration (update these to match your Moodle installation)
MOODLE_URL=http://your-moodle-site.com
MOODLE_API_TOKEN=your-moodle-api-token
