# AI Service Configuration
PORT=8000
ENVIRONMENT=development

# Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-sonnet-20240229
MAX_TOKENS=1024
TEMPERATURE=0.7

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/metacognitive_db

# Redis
REDIS_URL=redis://localhost:6379

# Caching
ENABLE_CACHE=true
CACHE_TTL=3600
