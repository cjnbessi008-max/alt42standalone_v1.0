# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DB_PATH=../database/lms_checkpoint.db

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# LMS Integration (Mock or Real)
LMS_API_URL=http://localhost:3002/api
LMS_API_KEY=your_lms_api_key_here
LMS_ENABLED=false

# Logging
LOG_LEVEL=info
