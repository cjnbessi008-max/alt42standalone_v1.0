# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_education

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Mind Wandering Detection Parameters
INACTIVITY_THRESHOLD_SECONDS=30
MOUSE_STILLNESS_THRESHOLD_SECONDS=20
RAPID_CLICK_THRESHOLD=10
FOCUS_LOSS_WEIGHT=0.8
INACTIVITY_WEIGHT=0.6
MOUSE_STILLNESS_WEIGHT=0.5
RAPID_CLICK_WEIGHT=0.7
MIND_WANDERING_CONFIDENCE_THRESHOLD=0.65

# LMS Integration
LMS_API_URL=http://localhost:9000/api
LMS_API_KEY=your-lms-api-key-here

# Behavior Tracking
BEHAVIOR_BATCH_SIZE=50
BEHAVIOR_FLUSH_INTERVAL_SECONDS=10
