# Database
DATABASE_URL=postgresql://routine_user:routine_pass@localhost:5432/routine_cards
DATABASE_ECHO=false

# API Keys
CLAUDE_API_KEY=sk-ant-your-api-key-here

# Application
APP_NAME="Success Routine Cards"
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Configuration
AI_MODEL=claude-3-sonnet-20240229
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Scheduler
ENABLE_AUTO_GENERATION=true
CARD_GENERATION_TIME=07:00:00
CARD_RETENTION_DAYS=90

# LMS Integration (optional)
LMS_API_URL=https://your-lms-api.com
LMS_API_KEY=your-lms-api-key
