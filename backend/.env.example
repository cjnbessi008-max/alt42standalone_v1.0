# Application Settings
APP_NAME="Inefficient Loop Detector"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loop_detector
DATABASE_ECHO=False

# Moodle Integration
MOODLE_URL=https://your-moodle-site.com
MOODLE_TOKEN=your_web_service_token
MOODLE_WS_FUNCTION_PREFIX=local_loopdetector

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Analysis Settings
MAX_CODE_SIZE=50000
ANALYSIS_TIMEOUT=30
MAX_NESTED_LOOPS=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
