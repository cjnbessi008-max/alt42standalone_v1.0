# 서버 설정
HOST=0.0.0.0
PORT=8000

# LMS 연동 설정
LMS_TYPE=moodle  # moodle 또는 canvas
LMS_BASE_URL=https://your-lms-url.com
LMS_API_TOKEN=your_api_token_here

# 데이터베이스 설정 (향후 PostgreSQL 사용시)
DATABASE_URL=postgresql://user:password@localhost:5432/warmup_db

# CORS 설정
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
