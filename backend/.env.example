# Environment
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/alt42_db

# JWT
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis (optional)
REDIS_URL=redis://redis:6379/0

# Focus Intensity Algorithm Parameters
FOCUS_HIGH_ACCURACY_THRESHOLD=0.9
FOCUS_LOW_ACCURACY_THRESHOLD=0.5
FOCUS_CONSECUTIVE_CORRECT_THRESHOLD=3
FOCUS_CONSECUTIVE_INCORRECT_THRESHOLD=2
FOCUS_MIN_ATTEMPTS_FOR_ADJUSTMENT=3

# Logging
LOG_LEVEL=INFO
