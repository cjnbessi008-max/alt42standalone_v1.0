# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alt42_education
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_PREFIX=/api
API_RATE_LIMIT=100

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3001

# JWT (for future authentication)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=1h

# LMS Integration
LMS_WEBHOOK_SECRET=your_webhook_secret_here
