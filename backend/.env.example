# Backend Environment Variables

# Application Settings
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME=AI Education System - LMS Integration
VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/ai_education_db

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CORS Settings (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# LMS Integration
LMS_API_ENDPOINT=https://your-lms-domain.com/api
LMS_API_KEY=your_lms_api_key_here
LMS_SYNC_INTERVAL_MINUTES=30

# Pattern Analysis Settings
PATTERN_MIN_FREQUENCY=2
PATTERN_ANALYSIS_DAYS_BACK=30
WARNING_SEVERITY_THRESHOLD=medium

# Security
SECRET_KEY=change_this_to_a_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
