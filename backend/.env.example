# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/alt42_lms
DATABASE_SYNC_URL=postgresql://user:password@localhost:5432/alt42_lms

# Redis
REDIS_URL=redis://localhost:6379/0

# Claude API
ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229

# Application
APP_NAME="ALT42 LMS Hint System"
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your_secret_key_here_change_in_production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LTI Configuration
LTI_CONSUMER_KEY=your_lti_consumer_key
LTI_SHARED_SECRET=your_lti_shared_secret

# Hint Generation Settings
MAX_HINT_TOKENS=500
HINT_CACHE_TTL=3600
