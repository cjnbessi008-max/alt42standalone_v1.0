# Application Settings
APP_NAME="Moodle LMS Correlation Analysis System"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/moodle_correlation
DB_ECHO=False

# Moodle API Settings
MOODLE_BASE_URL=https://your-moodle-instance.com
MOODLE_API_TOKEN=your-moodle-api-token-here
MOODLE_SERVICE=moodle_mobile_app

# Redis Settings (Optional - for Celery and caching)
REDIS_URL=redis://localhost:6379/0

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Reasoning Density Calculation Weights
WEIGHT_TIME_DENSITY=0.30
WEIGHT_ATTEMPT_INTENSITY=0.25
WEIGHT_COGNITIVE_LOAD=0.20
WEIGHT_COMPLEXITY=0.15
WEIGHT_SOLUTION_PATH=0.10

# Statistical Analysis Settings
SIGNIFICANCE_LEVEL=0.05
CONFIDENCE_LEVEL=0.95

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
