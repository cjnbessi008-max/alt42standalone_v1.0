# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://quantifier:quantifier123@localhost:5432/quantifier_friends
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantifier_friends
DB_USER=quantifier
DB_PASSWORD=quantifier123

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Moodle LMS Integration
