# Answer Classification API - Environment Variables
# Copy this file to .env and fill in your actual values

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
CLAUDE_MODEL=claude-3-sonnet-20240229

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/answer_classification
DB_ECHO=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://kaist.ac.kr

# LMS Integration
LTI_KEY=your_lti_consumer_key
LTI_SECRET=your_lti_shared_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
DEBUG=false
LOG_LEVEL=INFO

# Classification Settings
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
MAX_CLASSIFICATION_RETRIES=3
