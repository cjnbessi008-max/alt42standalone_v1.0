# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/lms_emotion_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lms_emotion_db
DATABASE_USER=username
DATABASE_PASSWORD=password

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG_MODE=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# WebSocket Configuration
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# Emotion Detection Settings
EMOTION_DETECTION_ALGORITHM_VERSION=1.0
DEFAULT_DETECTION_SENSITIVITY=medium
BATCH_METRICS_INTERVAL_MS=5000

# Data Retention (days)
BEHAVIOR_METRICS_RETENTION_DAYS=90
EMOTIONAL_STATES_RETENTION_DAYS=180

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Security (for production)
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Feature Flags
ENABLE_ML_DETECTION=false
ENABLE_TELEMETRY=true
ENABLE_ANALYTICS=true
