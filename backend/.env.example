# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Moodle Database (MySQL 5.7) - Read Only
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_USER=relaxation_ro
MOODLE_DB_PASSWORD=your_moodle_db_password
MOODLE_DB_NAME=moodle

# Application Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/relaxation_db?schema=public"

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Routine Trigger Settings
CORRECT_ANSWER_STREAK=3
ROUTINE_PROBABILITY=0.8
MIN_TIME_BETWEEN_ROUTINES=300
