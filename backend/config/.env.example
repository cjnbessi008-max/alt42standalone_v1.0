# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dmn_drift_tracker
DB_USER=root
DB_PASS=

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Moodle Integration
MOODLE_URL=http://your-moodle-site.com
MOODLE_TOKEN=your_moodle_webservice_token
MOODLE_LTI_KEY=your_lti_consumer_key
MOODLE_LTI_SECRET=your_lti_shared_secret

# DMN Drift Thresholds
DMN_THRESHOLD_MODERATE=40
DMN_THRESHOLD_HIGH=60
DMN_THRESHOLD_CRITICAL=80

# Session Settings
SESSION_TIMEOUT=3600
IDLE_THRESHOLD_SECONDS=5

# Logging
LOG_LEVEL=debug
LOG_PATH=../logs/app.log
