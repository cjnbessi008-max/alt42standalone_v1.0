# Heavy Term .gitignore

# Configuration files with sensitive data
config/config.php

# Logs
logs/
*.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Node modules (if adding build tools later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build files (if adding build process later)
dist/
build/

# PHP
vendor/
composer.lock

# Database
*.sql.gz
*.sql.backup

# Uploads/User content
uploads/
user_data/
