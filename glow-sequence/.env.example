# Glow Sequence - Environment Configuration
# Copy this file to .env and update with your actual values

# ===========================================
# Glow Sequence Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=glow_sequence_db
DB_USER=root
DB_PASS=

# ===========================================
# Moodle Database Configuration (Optional)
# ===========================================
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=root
MOODLE_DB_PASS=
MOODLE_DB_PREFIX=mdl_

# ===========================================
# Application Settings
# ===========================================
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/glow-sequence

# ===========================================
# Session Configuration
# ===========================================
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

# ===========================================
# CORS Settings
# ===========================================
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_PATH=/var/log/glow-sequence

# ===========================================
# Security
# ===========================================
# Generate a random string for this
APP_KEY=

# ===========================================
# Optional: Email Configuration
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Glow Sequence"
