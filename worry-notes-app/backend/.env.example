# Application
APP_NAME=Worry Notes System
ENV=development
DEBUG=True
API_VERSION=v1
SECRET_KEY=your-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/worry_notes
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Claude AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# Voyage AI (for embeddings)
VOYAGE_API_KEY=your-voyage-api-key

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Worry Notes System

# LMS Integration
# Canvas
CANVAS_API_URL=https://your-institution.instructure.com/api/v1
CANVAS_API_KEY=your-canvas-api-key

# Moodle
MOODLE_URL=https://moodle.yourdomain.com
MOODLE_TOKEN=your-moodle-token

# Google Classroom
GOOGLE_CLASSROOM_CLIENT_ID=your-client-id
GOOGLE_CLASSROOM_CLIENT_SECRET=your-client-secret

# LTI 1.3
LTI_ISS=https://your-lms.com
LTI_CLIENT_ID=your-client-id
LTI_DEPLOYMENT_ID=your-deployment-id
LTI_KEY_ID=your-key-id
LTI_PRIVATE_KEY_PATH=./keys/private.key
LTI_PUBLIC_KEY_PATH=./keys/public.key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Monitoring
SENTRY_DSN=your-sentry-dsn

# Feature Flags
ENABLE_LMS_INTEGRATION=True
ENABLE_AI_CATEGORIZATION=True
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_CRISIS_DETECTION=True

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Cache
CACHE_TTL_SECONDS=3600
LMS_CONTEXT_CACHE_HOURS=6

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png,gif

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
