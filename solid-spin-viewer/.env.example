# Solid Spin Viewer - Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=solid_spin_viewer
DB_USER=root
DB_PASS=your_password_here

# Moodle Database Configuration
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=root
MOODLE_DB_PASS=your_moodle_password_here
MOODLE_DB_PREFIX=mdl_

# Application Settings
APP_DEBUG=false
APP_TIMEZONE=Asia/Seoul

# CORS Settings (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# Session Settings
SESSION_LIFETIME=7200
