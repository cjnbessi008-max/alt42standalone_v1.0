# Combination Blocks Environment Configuration
# Copy this file to .env and update values

# Database Configuration (Combination Blocks DB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=combination_blocks
DB_USER=root
DB_PASS=your_password_here

# Moodle Database Configuration
MOODLE_DB_HOST=localhost
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodleuser
MOODLE_DB_PASS=your_moodle_password
MOODLE_DB_PREFIX=mdl_

# Moodle Installation
MOODLE_PATH=/var/www/html/moodle
MOODLE_URL=http://localhost/moodle

# API Configuration
API_PORT=8080
API_BASE_URL=http://localhost:8080/api

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Session Configuration
SESSION_SECRET=change_this_to_a_random_secret_key
SESSION_TIMEOUT=86400

# Logging
LOG_LEVEL=debug
LOG_PATH=/var/log/combination-blocks

# Environment
NODE_ENV=development
