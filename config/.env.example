# Moodle Database Configuration
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASS=your_password
MOODLE_DB_PREFIX=mdl_

# Application Settings
APP_ENV=development
APP_DEBUG=true
CACHE_ENABLED=true
CACHE_TTL=3600

# API Settings
API_TIMEOUT=30
MAX_QUESTIONS_PER_PAGE=20
