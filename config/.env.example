# Root Glow Environment Configuration
# .env.example 파일을 .env로 복사하고 실제 값으로 수정하세요

# Database Configuration
DB_HOST=localhost
DB_NAME=root_glow_db
DB_USER=root
DB_PASS=

# Moodle Configuration
MOODLE_ENABLED=false
MOODLE_URL=https://your-moodle-site.com
MOODLE_TOKEN=your_moodle_token_here

# Application Settings
APP_DEBUG=true
APP_ENV=development

# Security
SESSION_LIFETIME=3600
CSRF_TOKEN_EXPIRY=7200

# API Settings
API_RATE_LIMIT=100
API_TIMEOUT=30
