# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/alt42
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LMS Integration
# Canvas
CANVAS_API_URL=https://canvas.instructure.com
CANVAS_API_KEY=your_canvas_api_key

# Moodle
MOODLE_API_URL=https://moodle.example.com
MOODLE_API_TOKEN=your_moodle_token

# Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI/ML Settings
TIP_RECOMMENDATION_THRESHOLD=0.5
MAX_ALTERNATIVE_TIPS=3
DEFAULT_TIP_LEVEL=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_AUTO_CLASSIFICATION=true
ENABLE_PERSONALIZED_TIPS=true
ENABLE_TIP_ANALYTICS=true

# Institution Settings
INSTITUTION_NAME=KAIST
INSTITUTION_TIMEZONE=Asia/Seoul
DEFAULT_LANGUAGE=ko
