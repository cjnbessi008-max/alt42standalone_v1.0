# Alt42 Focus Tracking - Backend Configuration Example
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/alt42_focus_tracking
SQL_ECHO=false

# API Configuration
API_KEY=your-secret-api-key-here
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=your-super-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,https://moodle.yourdomain.com
ALLOWED_CREDENTIALS=true

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_FOCUS_TRACKING=true
ENABLE_AUTO_BREAKS=true
ENABLE_ANALYTICS=true
ENABLE_MOODLE_SYNC=true

# Default Settings
DEFAULT_IDLE_TIMEOUT_SECONDS=120
DEFAULT_BREAK_FREQUENCY_MINUTES=30
DEFAULT_ROUTINE_TYPE=breathing

# Moodle Integration
MOODLE_INSTANCES=moodle1,moodle2
MOODLE1_URL=https://moodle.example.com
MOODLE1_TOKEN=your-moodle-webservice-token

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@alt42.com

# Analytics & Monitoring
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=

# Development/Testing
DEBUG=false
TESTING=false
