{
  "system": {
    "name": "Mental Care Messaging System",
    "version": "1.0.0",
    "description": "Real-time learning speed monitoring and mental care support for students"
  },
  "analyzer": {
    "time_window_minutes": 30,
    "min_problems_for_analysis": 3,
    "thresholds": {
      "speed_decrease_minor": 0.20,
      "speed_decrease_moderate": 0.40,
      "speed_decrease_major": 0.60,
      "low_accuracy": 0.50,
      "long_session_minutes": 90,
      "stuck_time_threshold_minutes": 15,
      "consecutive_errors": 4
    }
  },
  "messaging": {
    "languages": ["ko", "en"],
    "default_language": "ko",
    "message_types": [
      "encouragement",
      "break_suggestion",
      "strategy_tip",
      "celebration"
    ],
    "severity_levels": ["low", "medium", "high"]
  },
  "frontend": {
    "max_visible_messages": 3,
    "auto_hide_delay_ms": 0,
    "notification_sound_enabled": true,
    "notification_sound_volume": 0.3
  },
  "websocket": {
    "reconnect_attempts": 5,
    "initial_reconnect_delay_ms": 1000,
    "max_reconnect_delay_ms": 30000,
    "heartbeat_interval_ms": 30000
  },
  "api": {
    "base_url": "http://localhost:8000",
    "ws_url": "ws://localhost:8000",
    "timeout_ms": 10000,
    "rate_limit": {
      "requests_per_minute": 100,
      "burst_size": 20
    }
  },
  "database": {
    "retention_days": {
      "student_attempts": 365,
      "learning_speed_metrics": 180,
      "mental_care_messages": 90
    },
    "aggregation_intervals": ["30min", "1hour", "1day"]
  },
  "features": {
    "enable_real_time_analysis": true,
    "enable_websocket": true,
    "enable_message_feedback": true,
    "enable_analytics": true,
    "enable_admin_dashboard": true
  },
  "recommendations": {
    "break_suggestions": {
      "session_60_90_min": "5-10 minutes",
      "session_90_120_min": "10-15 minutes",
      "session_over_120_min": "15-20 minutes"
    },
    "action_mapping": {
      "encourage": "Show encouragement message",
      "suggest_break": "Suggest taking a break",
      "suggest_strategy": "Provide learning strategy tip",
      "offer_help": "Suggest asking for help",
      "offer_hint": "Suggest using a hint"
    }
  }
}
