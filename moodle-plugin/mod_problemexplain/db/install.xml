<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/problemexplain/db" VERSION="20251118" COMMENT="XMLDB file for Problem Explanation Activity Module">
  <TABLES>
    <!-- Main activity instance table -->
    <TABLE NAME="problemexplain" COMMENT="Problem Explanation activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Activity name"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Activity description"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="problem_text" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="The problem to be explained"/>
        <FIELD NAME="problem_type" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="Type: arithmetic, algebra, geometry, etc."/>
        <FIELD NAME="min_steps" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="3" SEQUENCE="false" COMMENT="Minimum steps required"/>
        <FIELD NAME="max_steps" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="10" SEQUENCE="false" COMMENT="Maximum steps allowed"/>
        <FIELD NAME="enable_peer_review" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Enable peer review feature"/>
        <FIELD NAME="peer_reviews_required" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="2" SEQUENCE="false" COMMENT="Number of peer reviews required"/>
        <FIELD NAME="enable_ai_evaluation" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Enable AI evaluation"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="100" SEQUENCE="false" COMMENT="Maximum grade"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <!-- Student explanations table -->
    <TABLE NAME="problemexplain_submissions" COMMENT="Student problem explanations">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="problemexplain_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft, submitted, graded"/>
        <FIELD NAME="explanation_title" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Student's title for their explanation"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timesubmitted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="problemexplain" TYPE="foreign" FIELDS="problemexplain_id" REFTABLE="problemexplain" REFFIELDS="id"/>
        <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="problemexplain_user" UNIQUE="true" FIELDS="problemexplain_id, userid"/>
      </INDEXES>
    </TABLE>

    <!-- Explanation steps table -->
    <TABLE NAME="problemexplain_steps" COMMENT="Individual steps in student explanations">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="submission_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="step_number" TYPE="int" LENGTH="2" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="step_title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Brief title for this step"/>
        <FIELD NAME="step_explanation" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Detailed explanation text"/>
        <FIELD NAME="step_image" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Optional image/diagram URL"/>
        <FIELD NAME="step_reasoning" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Why this step is necessary"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="submission" TYPE="foreign" FIELDS="submission_id" REFTABLE="problemexplain_submissions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="submission_step" UNIQUE="true" FIELDS="submission_id, step_number"/>
      </INDEXES>
    </TABLE>

    <!-- AI evaluation results table -->
    <TABLE NAME="problemexplain_ai_eval" COMMENT="AI evaluation of student explanations">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="submission_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="clarity_score" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" SEQUENCE="false" COMMENT="Clarity score 0-100"/>
        <FIELD NAME="completeness_score" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" SEQUENCE="false" COMMENT="Completeness score 0-100"/>
        <FIELD NAME="accuracy_score" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" SEQUENCE="false" COMMENT="Accuracy score 0-100"/>
        <FIELD NAME="pedagogy_score" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" SEQUENCE="false" COMMENT="Teaching quality score 0-100"/>
        <FIELD NAME="overall_score" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" SEQUENCE="false" COMMENT="Overall score 0-100"/>
        <FIELD NAME="feedback_text" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="AI-generated feedback"/>
        <FIELD NAME="suggestions" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Improvement suggestions"/>
        <FIELD NAME="ai_model" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="AI model used"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="submission" TYPE="foreign" FIELDS="submission_id" REFTABLE="problemexplain_submissions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="submission_id" UNIQUE="false" FIELDS="submission_id"/>
      </INDEXES>
    </TABLE>

    <!-- Peer review table -->
    <TABLE NAME="problemexplain_peer_reviews" COMMENT="Peer reviews of explanations">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="submission_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Submission being reviewed"/>
        <FIELD NAME="reviewer_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Student doing the review"/>
        <FIELD NAME="understanding_score" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false" COMMENT="How well they understood: 1-5"/>
        <FIELD NAME="helpfulness_score" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false" COMMENT="How helpful: 1-5"/>
        <FIELD NAME="clarity_score" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false" COMMENT="How clear: 1-5"/>
        <FIELD NAME="review_text" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Written feedback"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="submission" TYPE="foreign" FIELDS="submission_id" REFTABLE="problemexplain_submissions" REFFIELDS="id"/>
        <KEY NAME="reviewer" TYPE="foreign" FIELDS="reviewer_id" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="submission_reviewer" UNIQUE="true" FIELDS="submission_id, reviewer_id"/>
      </INDEXES>
    </TABLE>

    <!-- Teacher grades table -->
    <TABLE NAME="problemexplain_grades" COMMENT="Teacher grades for submissions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="submission_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="feedback" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="grader_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="submission" TYPE="foreign" FIELDS="submission_id" REFTABLE="problemexplain_submissions" REFFIELDS="id"/>
        <KEY NAME="grader" TYPE="foreign" FIELDS="grader_id" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="submission_id" UNIQUE="true" FIELDS="submission_id"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
