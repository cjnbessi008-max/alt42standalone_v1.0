<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="question/behaviour/selfexplanation/db" VERSION="20251118" COMMENT="XMLDB file for Moodle question/behaviour/selfexplanation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="qbehaviour_selfexplanation" COMMENT="Stores student explanations for quiz questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionattemptid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Question attempt ID"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Student user ID"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Question ID"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Quiz attempt ID"/>
        <FIELD NAME="explanation" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Student explanation text"/>
        <FIELD NAME="word_count" TYPE="int" LENGTH="5" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Word count"/>
        <FIELD NAME="char_count" TYPE="int" LENGTH="6" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Character count"/>
        <FIELD NAME="quality_score" TYPE="number" LENGTH="3" NOTNULL="false" DECIMALS="2" SEQUENCE="false" COMMENT="Quality score 0.00-1.00"/>
        <FIELD NAME="ai_feedback" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="AI-generated feedback"/>
        <FIELD NAME="teacher_rating" TYPE="int" LENGTH="1" NOTNULL="false" SEQUENCE="false" COMMENT="Teacher rating 1-5 stars"/>
        <FIELD NAME="teacher_comment" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Teacher comment"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time created"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time modified"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionattemptid" TYPE="foreign" FIELDS="questionattemptid" REFTABLE="question_attempts" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_idx" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="questionid_idx" UNIQUE="false" FIELDS="questionid"/>
        <INDEX NAME="attemptid_idx" UNIQUE="false" FIELDS="attemptid"/>
        <INDEX NAME="quality_idx" UNIQUE="false" FIELDS="quality_score"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="qbehaviour_selfexpl_config" COMMENT="Configuration for self-explanation per quiz/question">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Quiz ID"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Question ID (NULL = all questions)"/>
        <FIELD NAME="require_on_correct" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="1" SEQUENCE="false" COMMENT="Require explanation on correct answer"/>
        <FIELD NAME="require_on_incorrect" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Require explanation on incorrect answer"/>
        <FIELD NAME="min_words" TYPE="int" LENGTH="4" NOTNULL="false" DEFAULT="20" SEQUENCE="false" COMMENT="Minimum words"/>
        <FIELD NAME="min_chars" TYPE="int" LENGTH="5" NOTNULL="false" DEFAULT="50" SEQUENCE="false" COMMENT="Minimum characters"/>
        <FIELD NAME="enable_ai_analysis" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Enable AI analysis"/>
        <FIELD NAME="blocked_phrases" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of blocked phrases"/>
        <FIELD NAME="required_keywords" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of required keywords"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time created"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="quizid" TYPE="foreign" FIELDS="quizid" REFTABLE="quiz" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="quizid_idx" UNIQUE="false" FIELDS="quizid"/>
        <INDEX NAME="questionid_idx" UNIQUE="false" FIELDS="questionid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="qbehaviour_selfexpl_keywords" COMMENT="Keywords for questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Question ID"/>
        <FIELD NAME="keyword" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Keyword"/>
        <FIELD NAME="category" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Category: concept, method, formula, etc."/>
        <FIELD NAME="importance" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="1" SEQUENCE="false" COMMENT="Importance 1-5"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time created"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="questionid_idx" UNIQUE="false" FIELDS="questionid"/>
        <INDEX NAME="keyword_idx" UNIQUE="false" FIELDS="keyword"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
