# Wave Rate Application Environment Configuration
# Copy this file to .env and update with your actual values

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wave_rate_db
DB_USER=root
DB_PASS=

# Moodle LMS Integration
# Get your Moodle token from: Site Administration > Server > Web services > Manage tokens
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=

# Application Settings
APP_DEBUG=true
APP_TIMEZONE=Asia/Seoul
