# Trap Detection LMS - Environment Variables Example
# Copy this file to .env and update with your settings

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trap_detection_lms
DB_USER=root
DB_PASS=

# LTI Configuration
LTI_CONSUMER_KEY=trap_detection_key
LTI_CONSUMER_SECRET=change_this_secret_in_production

# Moodle Integration
MOODLE_URL=http://localhost/moodle
MOODLE_API_TOKEN=

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Seoul
