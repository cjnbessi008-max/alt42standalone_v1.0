<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/engagementalert/db" VERSION="20251118" COMMENT="XMLDB file for Moodle local/engagementalert"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <!-- Table for tracking user engagement events -->
    <TABLE NAME="local_engagement_events" COMMENT="Stores user engagement tracking events">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Course module ID (optional)"/>
        <FIELD NAME="eventtype" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="Type of event: mouse, keyboard, focus, blur, scroll"/>
        <FIELD NAME="timestamp" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp"/>
        <FIELD NAME="sessionid" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Session identifier"/>
        <FIELD NAME="metadata" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Additional event data (JSON)"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
        <INDEX NAME="sessionid" UNIQUE="false" FIELDS="sessionid"/>
        <INDEX NAME="timestamp" UNIQUE="false" FIELDS="timestamp"/>
      </INDEXES>
    </TABLE>

    <!-- Table for tracking detected DMN drift incidents -->
    <TABLE NAME="local_engagement_alerts" COMMENT="Stores detected DMN drift incidents and alerts">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Course module ID"/>
        <FIELD NAME="sessionid" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Session identifier"/>
        <FIELD NAME="alerttype" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="Type: inactive, unfocused, slow_progress"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Duration of drift in seconds"/>
        <FIELD NAME="detected_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="When drift was detected"/>
        <FIELD NAME="notified_student" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Student notified flag"/>
        <FIELD NAME="notified_teacher" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Teacher notified flag"/>
        <FIELD NAME="severity" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Severity level 1-5"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
        <INDEX NAME="detected_at" UNIQUE="false" FIELDS="detected_at"/>
        <INDEX NAME="sessionid" UNIQUE="false" FIELDS="sessionid"/>
      </INDEXES>
    </TABLE>

    <!-- Table for storing engagement session summaries -->
    <TABLE NAME="local_engagement_sessions" COMMENT="Stores engagement session summaries">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="sessionid" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Session identifier"/>
        <FIELD NAME="started_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Session start time"/>
        <FIELD NAME="ended_at" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Session end time"/>
        <FIELD NAME="total_events" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Total events tracked"/>
        <FIELD NAME="total_alerts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Total alerts triggered"/>
        <FIELD NAME="engagement_score" TYPE="number" LENGTH="5" NOTNULL="false" DECIMALS="2" SEQUENCE="false" COMMENT="Overall engagement score 0-100"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sessionid" UNIQUE="true" FIELDS="sessionid"/>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
        <INDEX NAME="started_at" UNIQUE="false" FIELDS="started_at"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
