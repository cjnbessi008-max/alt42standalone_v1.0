# AI Education Pipeline - Standalone Web App Environment Variables
# Copy this to .env and fill in your values

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
DEBUG=true

# ============================================
# Database (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aipipeline
DB_USER=aipipeline
DB_PASSWORD=dev_password_change_in_production

# Full connection string
DATABASE_URL=postgresql://aipipeline:dev_password_change_in_production@localhost:5432/aipipeline

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ============================================
# Claude AI API
# ============================================
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4000

# ============================================
# API Gateway (if using)
# ============================================
API_GATEWAY_PORT=4000
AI_PIPELINE_URL=http://localhost:8000

# ============================================
# Frontend (if using)
# ============================================
VITE_API_URL=http://localhost:8000/api

# ============================================
# Security
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Email (for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
ADMIN_EMAIL=admin@kaist.ac.kr
