# Dual Dance Standalone Web App - Environment Configuration
# Copy this file to .env and update the values

# Application Settings
APP_NAME="Dual Dance"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Database Configuration (MySQL 5.7)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=dualdance
DB_USER=dualdance_user
DB_PASSWORD=dualdance_pass
MYSQL_ROOT_PASSWORD=root_password

# JWT Authentication
JWT_SECRET=your-secret-key-change-this-to-random-string
JWT_EXPIRATION=86400

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Mail Configuration (optional - for password reset)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@dualdance.local
MAIL_FROM_NAME="Dual Dance"

# Application Settings
DEFAULT_DIFFICULTY=3
DEFAULT_ANIMATION_SPEED=3
PROBLEMS_PER_SESSION=10

# Security
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=info
LOG_FILE=/var/www/html/logs/app.log

# Development Settings (set APP_ENV=development to enable)
DEV_ALLOW_REGISTRATION=true
DEV_SHOW_ERRORS=false
