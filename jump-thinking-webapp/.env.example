# Jump Thinking Web App - Environment Configuration
# Copy this file to .env and update values

# Application
APP_URL=http://localhost
APP_DEBUG=true

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jump_thinking_db
DB_USER=root
DB_PASS=

# LTI Configuration
LTI_CONSUMER_KEY=moodle_demo_key
LTI_CONSUMER_SECRET=moodle_demo_secret_12345

# Session
SESSION_LIFETIME=3600

# Logging
LOG_LEVEL=info
