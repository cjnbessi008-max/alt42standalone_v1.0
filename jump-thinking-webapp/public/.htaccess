# Public Directory Configuration

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Remove /public from URL
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [L]
</IfModule>

# Protect PHP files from direct access (except specific entry points)
<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Allow specific PHP entry points
<FilesMatch "^(index|lti_launch)\.php$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
