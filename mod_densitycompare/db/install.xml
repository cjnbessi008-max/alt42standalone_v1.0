<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/densitycompare/db" VERSION="20251118" COMMENT="XMLDB file for Moodle mod_densitycompare"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="densitycompare" COMMENT="Main table for density compare activities">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="densitycompare_problems" COMMENT="Problems for density comparison">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="densitycompare_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="problem_type" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="rectangle, circle, triangle"/>
        <FIELD NAME="shape1_data" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON data for shape 1"/>
        <FIELD NAME="shape2_data" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON data for shape 2"/>
        <FIELD NAME="color1" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="#FF6B6B" SEQUENCE="false"/>
        <FIELD NAME="color2" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="#4ECDC4" SEQUENCE="false"/>
        <FIELD NAME="question_text" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="correct_answer" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="larger, smaller, equal"/>
        <FIELD NAME="difficulty" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="densitycompare_id" TYPE="foreign" FIELDS="densitycompare_id" REFTABLE="densitycompare" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="densitycompare_attempts" COMMENT="Student attempts at density problems">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="problem_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="answer" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="is_correct" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="time_spent" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time in seconds"/>
        <FIELD NAME="timeattempted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="problem_id" TYPE="foreign" FIELDS="problem_id" REFTABLE="densitycompare_problems" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_problem" UNIQUE="false" FIELDS="userid, problem_id"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
