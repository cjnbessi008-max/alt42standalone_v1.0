# Truth Rhythm - Git Ignore

# Configuration files with sensitive data
api/config.php

# Logs
logs/
*.log

# Sound files (can be large)
public/sounds/*.mp3
public/sounds/*.wav
public/sounds/*.ogg
!public/sounds/README.md

# Database backups
*.sql
database/backups/

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# PHP
vendor/
composer.lock
*.cache

# Temporary files
tmp/
temp/
*.tmp

# Environment files
.env
.env.local
.env.production

# Session files
sessions/

# Upload directories
uploads/
public/uploads/

# Cache
cache/
*.cache

# Node modules (if using any frontend build tools)
node_modules/
package-lock.json
yarn.lock

# Build files
dist/
build/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Backup files
*.bak
*~
*.swp
*.swo

# Test files
phpunit.xml
.phpunit.result.cache
tests/_output/
