{
    "name": "kaist/alt42standalone",
    "description": "Moodle LMS Integration for AI Education System Pipeline",
    "type": "library",
    "keywords": ["moodle", "lms", "education", "ai", "kaist"],
    "license": "proprietary",
    "authors": [
        {
            "name": "KAIST Touch Math Academy",
            "email": "support@kaist-touchmath.edu"
        }
    ],
    "require": {
        "php": ">=7.1.9",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Alt42Standalone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alt42Standalone\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
