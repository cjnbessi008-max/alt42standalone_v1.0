    {
      "id": "prob-007",
      "category": "경우의수와확률",
      "subcategory": "확률",
      "name": "확률의 정의",
      "formula": "P(A) = \\frac{n(A)}{n(S)}",
      "description": "사건 A가 일어날 확률 (전체 경우의 수 중 사건 A의 경우의 수)",
      "difficulty": "쉬움",
      "grade": "중2",
      "tags": ["확률"],
      "relatedFormulas": ["prob-008"]
    },
    {
      "id": "prob-008",
      "category": "경우의수와확률",
      "subcategory": "확률",
      "name": "확률의 덧셈정리",
      "formula": "P(A \\cup B) = P(A) + P(B) - P(A \\cap B)",
      "description": "두 사건 A, B의 합사건의 확률",
      "difficulty": "중",
      "grade": "고1",
      "tags": ["확률", "덧셈정리"],
      "relatedFormulas": ["prob-007", "prob-009"]
    },
    {
      "id": "prob-009",
      "category": "경우의수와확률",
      "subcategory": "확률",
      "name": "여사건의 확률",
      "formula": "P(A^c) = 1 - P(A)",
      "description": "사건 A가 일어나지 않을 확률",
      "difficulty": "쉬움",
      "grade": "고1",
      "tags": ["확률", "여사건"],
      "relatedFormulas": ["prob-007"]
    },
    {
      "id": "prob-010",
      "category": "경우의수와확률",
      "subcategory": "조건부 확률",
      "name": "조건부 확률",
      "formula": "P(A|B) = \\frac{P(A \\cap B)}{P(B)} \\quad (P(B) > 0)",
      "description": "사건 B가 일어났을 때 사건 A가 일어날 확률",
      "difficulty": "어려움",
      "grade": "고2",
      "tags": ["확률", "조건부확률"],
