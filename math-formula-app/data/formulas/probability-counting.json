      "id": "prob-011",
      "category": "경우의수와확률",
      "subcategory": "확률의 곱셈정리",
      "name": "확률의 곱셈정리",
      "formula": "P(A \\cap B) = P(B)P(A|B) = P(A)P(B|A)",
      "description": "두 사건이 동시에 일어날 확률",
      "difficulty": "어려움",
      "grade": "고2",
      "tags": ["확률", "곱셈정리"],
      "relatedFormulas": ["prob-010", "prob-012"]
