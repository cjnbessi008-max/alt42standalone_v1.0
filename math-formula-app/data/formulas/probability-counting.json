    },
    {
      "id": "prob-004",
      "category": "경우의수와확률",
      "subcategory": "순열",
      "name": "n!의 정의",
      "formula": "n! = n \\times (n-1) \\times (n-2) \\times \\cdots \\times 2 \\times 1",
      "description": "n 팩토리얼 (0! = 1)",
      "difficulty": "쉬움",
      "grade": "고1",
