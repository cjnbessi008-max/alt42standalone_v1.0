# Convergence Glow Environment Configuration
# .env.example - 이 파일을 복사하여 .env로 저장하고 실제 값을 입력하세요

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=convergence_glow
DB_USER=your_database_user
DB_PASS=your_database_password

# Moodle Configuration
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=your_moodle_webservice_token

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/convergence-glow

# Session Configuration
SESSION_TIMEOUT=3600

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000
