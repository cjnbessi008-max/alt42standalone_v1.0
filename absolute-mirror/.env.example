# Absolute Mirror - Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com/absolute-mirror

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=absolute_mirror
DB_USER=abs_mirror
DB_PASS=your_secure_password_here

# Moodle Integration (Optional)
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASS=moodle_password
MOODLE_DB_PREFIX=mdl_

# Session Configuration
SESSION_LIFETIME=3600
SESSION_SECURE=true
SESSION_HTTPONLY=true

# Security
ALLOWED_ORIGINS=https://your-domain.com
API_RATE_LIMIT=100

# Features
DEMO_MODE=false
AUTO_LOAD_PROBLEM=true
ENABLE_MOODLE_SYNC=true

# Logging
LOG_LEVEL=error
LOG_PATH=/var/log/absolute-mirror
