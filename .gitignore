# Moodle Dancing Line Plugin - gitignore

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.cache

# Backup files
*.bak
*.backup

# Node modules (if any frontend tooling is added)
node_modules/

# Build artifacts
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# Database dumps
*.sql
*.sqlite

# Coverage reports
coverage/
.nyc_output/

# Testing
phpunit.xml
.phpunit.result.cache
