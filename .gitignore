*.bak
*.backup
*.old
*.tmp
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# PHP
vendor/
composer.lock

# Cache
cache/
*.cache

