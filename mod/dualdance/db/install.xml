<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/dualdance/db" VERSION="2025011800" COMMENT="XMLDB file for mod_dualdance"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="dualdance" COMMENT="Dual Dance activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course id"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Activity name"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Activity description"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="difficulty" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Difficulty level 1-5"/>
        <FIELD NAME="exp_base_min" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="1.5" SEQUENCE="false" DECIMALS="2" COMMENT="Minimum exponential base"/>
        <FIELD NAME="exp_base_max" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="3.0" SEQUENCE="false" DECIMALS="2" COMMENT="Maximum exponential base"/>
        <FIELD NAME="log_base_min" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="2.0" SEQUENCE="false" DECIMALS="2" COMMENT="Minimum logarithm base"/>
        <FIELD NAME="log_base_max" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="10.0" SEQUENCE="false" DECIMALS="2" COMMENT="Maximum logarithm base"/>
        <FIELD NAME="animation_speed" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="2" SEQUENCE="false" COMMENT="Animation speed 1-5"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="100" SEQUENCE="false" COMMENT="Maximum grade"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="dualdance_problems" COMMENT="Generated math problems">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="dualdanceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="problem_type" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="exponential, logarithmic, intersection"/>
        <FIELD NAME="exp_base" TYPE="number" LENGTH="10" NOTNULL="true" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="log_base" TYPE="number" LENGTH="10" NOTNULL="true" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="exp_coefficient" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="1.0" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="log_coefficient" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="1.0" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="question_text" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="answer" TYPE="number" LENGTH="15" NOTNULL="true" SEQUENCE="false" DECIMALS="4"/>
        <FIELD NAME="tolerance" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0.01" SEQUENCE="false" DECIMALS="4"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="dualdanceid" TYPE="foreign" FIELDS="dualdanceid" REFTABLE="dualdance" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="dualdance_attempts" COMMENT="Student attempts">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="dualdanceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="problemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="answer" TYPE="number" LENGTH="15" NOTNULL="true" SEQUENCE="false" DECIMALS="4"/>
        <FIELD NAME="is_correct" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="time_spent" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Seconds"/>
        <FIELD NAME="interaction_data" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON data of interactions"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="dualdanceid" TYPE="foreign" FIELDS="dualdanceid" REFTABLE="dualdance" REFFIELDS="id"/>
        <KEY NAME="problemid" TYPE="foreign" FIELDS="problemid" REFTABLE="dualdance_problems" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_dualdanceid" UNIQUE="false" FIELDS="userid, dualdanceid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="dualdance_grades" COMMENT="Final grades">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="dualdanceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="attempts_count" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="correct_count" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="total_time" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="dualdanceid" TYPE="foreign" FIELDS="dualdanceid" REFTABLE="dualdance" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_dualdanceid" UNIQUE="true" FIELDS="userid, dualdanceid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
