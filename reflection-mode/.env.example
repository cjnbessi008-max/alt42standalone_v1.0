# Reflection Mode Environment Configuration
# Copy this file to .env and update with your values

# Environment
ENVIRONMENT=development

# Database Configuration (MySQL 5.7)
DB_HOST=localhost
DB_NAME=reflection_mode
DB_USER=root
DB_PASS=your_password_here
DB_CHARSET=utf8mb4

# LTI Configuration (Moodle 3.7)
LTI_CONSUMER_KEY=reflection_mode_key
LTI_CONSUMER_SECRET=change_this_to_a_secure_random_string
LTI_SESSION_TIMEOUT=3600

# Application Settings
APP_NAME=Reflection Mode
APP_VERSION=1.0.0
APP_URL=https://yourdomain.com/reflection-mode

# Security
SESSION_SECRET=change_this_to_a_secure_random_string
SESSION_LIFETIME=86400

# Features
ENABLE_ANALYTICS=true
ENABLE_EXPORT=true
SHOW_HINTS=true
MAX_POINTS_PER_SHAPE=20
DEFAULT_TIME_LIMIT=300

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/reflection-mode/app.log

# CORS (if needed)
ALLOWED_ORIGINS=https://moodle.yourdomain.com

# PHP Settings (for reference - set in php.ini or .htaccess)
# upload_max_filesize=10M
# post_max_size=10M
# max_execution_time=30
# memory_limit=128M
