# API Configuration
API_TITLE="Thinking Routine AI Engine"
API_VERSION="1.0.0"
API_PREFIX="/api/v1"

# Moodle Database (MySQL 5.7) - Read-only access recommended
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_readonly
MOODLE_DB_PASSWORD=your_moodle_password
MOODLE_DB_PREFIX=mdl_

# Application Database (PostgreSQL for analytics and caching)
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=thinking_routine
APP_DB_USER=postgres
APP_DB_PASSWORD=your_postgres_password

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# Analysis Settings
TOP_PERFORMER_PERCENTILE=10.0
MIN_SESSIONS_FOR_ANALYSIS=5
SESSION_GAP_MINUTES=30
ANALYSIS_LOOKBACK_DAYS=90

# API Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourmoodle.com
